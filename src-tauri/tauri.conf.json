{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Handraw",
  "version": "0.2.3",
  "identifier": "com.walkskysu.handraw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Handraw · 手绘工作台",
        "center": true,
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
  "updater": {
    "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0QkEwQjBFNDk5M0FDNEYKUldSUHJKTkpEZ3U2QkdZTm1LbkZINTM1Snp6c21idWJuWTFZRG9YVVNZVXgyVVBES2pENHlYL1QK",
    "endpoints": [
      "https://github.com/walkskysu/handraw-style-codex/releases/latest/download/latest.json"
    ]
  }
}
}
